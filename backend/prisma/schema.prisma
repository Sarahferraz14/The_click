generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgcrypto, vector, citext]
}


// --- TIPOS (ENUMS) ---
enum MemberRole {
  owner
  guest
  @@map("member_role")
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
  @@map("invitation_status")
}

enum PermissionKey {
  control_gate
  control_lights
  manage_routines
  @@map("permission_key")
}

enum DeviceType {
  light
  gate
  lock
  camera
  motion_sensor
  door_sensor
  other
  @@map("device_type")
}

enum FaceAngle {
  front
  left
  right
  @@map("face_angle")
}

enum EventKind {
  presence_detected
  face_recognized
  face_unknown
  device_on
  device_off
  door_opened
  door_closed
  manual_command
  light_turned_off
  routine_executed
  @@map("event_kind")
}

enum EventSource {
  sensor
  camera
  user
  routine
  system
  @@map("event_source")
}

enum AlertKind {
  routine_deviation
  inactivity
  unknown_face
  device_offline
  manual
  @@map("alert_kind")
}

enum AlertSeverity {
  info
  warning
  critical
  @@map("alert_severity")
}

enum AlertStatus {
  open
  acknowledged
  resolved
  @@map("alert_status")
}

enum NotifyChannel {
  push
  email
  sms
  @@map("notify_channel")
}

// --- TABELAS ---

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name         String
  email             String    @unique @db.Citext
  password_hash     String
  language          String    @default("pt") @db.Char(2)
  email_verified_at DateTime? @db.Timestamptz
  last_login_at     DateTime? @db.Timestamptz
  created_at        DateTime  @default(now()) @db.Timestamptz
  updated_at        DateTime  @default(now()) @db.Timestamptz
  deleted_at        DateTime? @db.Timestamptz

  sessions              Session[]
  password_reset_tokens PasswordResetToken[]
  push_tokens           PushToken[]
  home_members          HomeMember[]         @relation("MemberUser")
  members_invited       HomeMember[]         @relation("MemberInvitedBy")
  invitations_sent      Invitation[]         @relation("InvitedBy")
  routines_created      Routine[]            @relation("RoutineCreatedBy")
  consents_given        KnownPerson[]        @relation("ConsentBy")
  events_acted          Event[]              @relation("EventActor")
  alerts_resolved       Alert[]              @relation("AlertResolvedBy")
  alert_deliveries      AlertDelivery[]
  audit_logs            AuditLog[]

  @@map("users")
}

model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique
  user_agent String?
  ip_address String?   @db.Inet
  expires_at DateTime  @db.Timestamptz
  created_at DateTime  @default(now()) @db.Timestamptz
  revoked_at DateTime? @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("sessions")
}

model PasswordResetToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique
  expires_at DateTime  @db.Timestamptz
  created_at DateTime  @default(now()) @db.Timestamptz
  used_at    DateTime? @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model PushToken {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @db.Uuid
  token       String   @unique
  device_info Json?
  created_at  DateTime @default(now()) @db.Timestamptz
  platform    String

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("push_tokens")
}

model Home {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  address    String?
  timezone   String   @default("America/Sao_Paulo")
  created_at DateTime @default(now()) @db.Timestamptz

  elders       Elder[]
  members      HomeMember[]
  invitations  Invitation[]
  rooms        Room[]
  known_people KnownPerson[]
  events       Event[]
  alerts       Alert[]
  audit_logs   AuditLog[]

  @@map("homes")
}

model Elder {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  home_id       String   @db.Uuid
  full_name     String
  date_of_birth DateTime? @db.Date
  notes         String?
  created_at    DateTime @default(now()) @db.Timestamptz

  home               Home               @relation(fields: [home_id], references: [id], onDelete: Cascade)
  known_person       KnownPerson?
  events             Event[]
  behavior_baselines BehaviorBaseline[]
  alerts             Alert[]

  @@index([home_id])
  @@map("elders")
}

model HomeMember {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  home_id    String     @db.Uuid
  user_id    String     @db.Uuid
  role       MemberRole @default(guest)
  invited_by String?    @db.Uuid
  created_at DateTime   @default(now()) @db.Timestamptz

  home                     Home                      @relation(fields: [home_id], references: [id], onDelete: Cascade)
  user                     User                      @relation("MemberUser", fields: [user_id], references: [id], onDelete: Cascade)
  inviter                  User?                     @relation("MemberInvitedBy", fields: [invited_by], references: [id], onDelete: NoAction)
  permissions              MemberPermission[]
  notification_preferences NotificationPreference?

  @@unique([home_id, user_id])
  @@map("home_members")
}

model MemberPermission {
  member_id  String        @db.Uuid
  permission PermissionKey

  member HomeMember @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@id([member_id, permission])
  @@map("member_permissions")
}

model Invitation {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  home_id     String           @db.Uuid
  invited_by  String           @db.Uuid
  full_name   String
  email       String           @db.Citext
  permissions PermissionKey[]  @default([control_lights])
  token_hash  String           @unique
  status      InvitationStatus @default(pending)
  expires_at  DateTime         @db.Timestamptz
  created_at  DateTime         @default(now()) @db.Timestamptz

  home    Home @relation(fields: [home_id], references: [id], onDelete: Cascade)
  inviter User @relation("InvitedBy", fields: [invited_by], references: [id])

  @@index([home_id, status])
  @@map("invitations")
}

model Room {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  home_id    String   @db.Uuid
  name       String
  icon       String?
  created_at DateTime @default(now()) @db.Timestamptz

  home               Home               @relation(fields: [home_id], references: [id], onDelete: Cascade)
  devices            Device[]
  events             Event[]
  behavior_baselines BehaviorBaseline[]

  @@unique([home_id, name])
  @@map("rooms")
}

model Device {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  room_id      String     @db.Uuid
  name         String
  type         DeviceType
  external_id  String?
  is_on        Boolean    @default(false)
  is_online    Boolean    @default(true)
  last_seen_at DateTime?  @db.Timestamptz
  config       Json       @default("{}")
  created_at   DateTime   @default(now()) @db.Timestamptz

  room     Room      @relation(fields: [room_id], references: [id], onDelete: Cascade)
  routines Routine[]
  events   Event[]

  @@index([room_id])
  @@map("devices")
}

model Routine {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  device_id    String   @db.Uuid
  turn_on_at   DateTime @db.Time
  turn_off_at  DateTime @db.Time
  days_of_week Int[]    @default([0, 1, 2, 3, 4, 5, 6]) @db.SmallInt
  enabled      Boolean  @default(true)
  created_by   String?  @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @default(now()) @db.Timestamptz

  device Device @relation(fields: [device_id], references: [id], onDelete: Cascade)
  user   User?  @relation("RoutineCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)

  @@index([device_id])
  @@map("routines")
}

model KnownPerson {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  home_id      String   @db.Uuid
  elder_id     String?  @unique @db.Uuid
  full_name    String
  relationship String?
  consent_at   DateTime @db.Timestamptz
  consent_by   String?  @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz

  home            Home             @relation(fields: [home_id], references: [id], onDelete: Cascade)
  elder           Elder?           @relation(fields: [elder_id], references: [id], onDelete: Cascade)
  consent_user    User?            @relation("ConsentBy", fields: [consent_by], references: [id], onDelete: NoAction)
  face_embeddings FaceEmbedding[]
  events          Event[]

  @@map("known_people")
}

model FaceEmbedding {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  person_id  String    @db.Uuid
  angle      FaceAngle
  embedding  Unsupported("vector(512)")
  model_ver  String
  created_at DateTime  @default(now()) @db.Timestamptz

  person KnownPerson @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@unique([person_id, angle, model_ver])
  @@map("face_embeddings")
}

model Event {
  id            BigInt      @id @default(autoincrement())
  home_id       String      @db.Uuid
  elder_id      String?     @db.Uuid
  room_id       String?     @db.Uuid
  device_id     String?     @db.Uuid
  person_id     String?     @db.Uuid
  actor_user_id String?     @db.Uuid
  kind          EventKind
  source        EventSource
  confidence    Float?      @db.Real
  payload       Json        @default("{}")
  occurred_at   DateTime    @default(now()) @db.Timestamptz

  home   Home         @relation(fields: [home_id], references: [id], onDelete: Cascade)
  elder  Elder?       @relation(fields: [elder_id], references: [id], onDelete: SetNull)
  room   Room?        @relation(fields: [room_id], references: [id], onDelete: SetNull)
  device Device?      @relation(fields: [device_id], references: [id], onDelete: SetNull)
  person KnownPerson? @relation(fields: [person_id], references: [id], onDelete: SetNull)
  actor  User?        @relation("EventActor", fields: [actor_user_id], references: [id], onDelete: SetNull)
  alerts Alert[]

  @@index([home_id, occurred_at(sort: Desc)])
  @@index([elder_id, kind, occurred_at(sort: Desc)])
  @@index([room_id, occurred_at(sort: Desc)])
  @@map("events")
}

model BehaviorBaseline {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  elder_id     String   @db.Uuid
  room_id      String?  @db.Uuid
  metric       String
  day_of_week  Int?     @db.SmallInt
  hour_bucket  Int?     @db.SmallInt
  mean_value   Float
  stddev_value Float
  sample_size  Int
  model_ver    String
  computed_at  DateTime @default(now()) @db.Timestamptz

  elder Elder @relation(fields: [elder_id], references: [id], onDelete: Cascade)
  room  Room? @relation(fields: [room_id], references: [id], onDelete: Cascade)

  @@unique([elder_id, room_id, metric, day_of_week, hour_bucket, model_ver])
  @@map("behavior_baselines")
}

model Alert {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  home_id               String        @db.Uuid
  elder_id              String?       @db.Uuid
  kind                  AlertKind
  severity              AlertSeverity
  title                 String
  description           String?
  evidence              Json          @default("{}")
  triggered_by_event_id BigInt?
  anomaly_score         Float?        @db.Real
  model_ver             String?
  status                AlertStatus   @default(open)
  detected_at           DateTime      @default(now()) @db.Timestamptz
  resolved_by           String?       @db.Uuid
  resolved_at           DateTime?     @db.Timestamptz

  home             Home            @relation(fields: [home_id], references: [id], onDelete: Cascade)
  elder            Elder?          @relation(fields: [elder_id], references: [id], onDelete: SetNull)
  trigger_event    Event?          @relation(fields: [triggered_by_event_id], references: [id], onDelete: SetNull)
  resolver         User?           @relation("AlertResolvedBy", fields: [resolved_by], references: [id], onDelete: NoAction)
  alert_deliveries AlertDelivery[]

  @@index([home_id, status, detected_at(sort: Desc)])
  @@map("alerts")
}

model AlertDelivery {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  alert_id        String        @db.Uuid
  user_id         String        @db.Uuid
  channel         NotifyChannel
  sent_at         DateTime?     @db.Timestamptz
  read_at         DateTime?     @db.Timestamptz
  acknowledged_at DateTime?     @db.Timestamptz

  alert Alert @relation(fields: [alert_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([alert_id, user_id, channel])
  @@map("alert_deliveries")
}

model NotificationPreference {
  member_id    String          @id @db.Uuid
  min_severity AlertSeverity   @default(warning)
  channels     NotifyChannel[] @default([push])
  quiet_from   DateTime?       @db.Time
  quiet_until  DateTime?       @db.Time

  member HomeMember @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  home_id    String?  @db.Uuid
  user_id    String?  @db.Uuid
  action     String
  entity     String?
  entity_id  String?
  metadata   Json     @default("{}")
  created_at DateTime @default(now()) @db.Timestamptz

  home Home? @relation(fields: [home_id], references: [id], onDelete: Cascade)
  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([home_id, created_at(sort: Desc)])
  @@map("audit_logs")
}